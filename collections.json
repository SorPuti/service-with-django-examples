{
  "info": {
    "_postman_id": "suggestions-api-collection",
    "name": "Service With Django - API Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Coleção de testes para as APIs do projeto: auth, suggestions, comments, votes, audit, onr-models. Inclui requests autenticados e não autenticados."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "user_email",
      "value": "user@example.com",
      "type": "string"
    },
    {
      "key": "user_password",
      "value": "admin",
      "type": "string"
    },
    {
      "key": "approver_email",
      "value": "approver@example.com",
      "type": "string"
    },
    {
      "key": "approver_password",
      "value": "approverpass",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "approver_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "suggestion_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "comment_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "vote_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "onr_id",
      "value": "",
      "type": "string"
    }
    ,
    {
      "key": "group_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "permission_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Root (index)",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/", "host": ["{{baseUrl}}"], "path": [""] }
      },
      "response": []
    },
    {
      "name": "Health / test view",
      "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/test/", "host": ["{{baseUrl}}"], "path": ["test",""] } },
      "response": []
    },
    {
      "name": "Admin (HTML)",
      "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/admin/", "host": ["{{baseUrl}}"], "path": ["admin",""] } },
      "response": []
    },
    {
      "name": "Register User",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{user_email}}\",\n  \"username\": \"user1\",\n  \"password1\": \"{{user_password}}\",\n  \"password2\": \"{{user_password}}\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/auth/registration/", "host": ["{{baseUrl}}"], "path": ["api","auth","registration",""] }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('registration status 201 or 200', function() {",
              "  pm.expect(pm.response.code).to.be.oneOf([200,201]);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Login User (get JWT pair)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"lucas\",\n  \"password\": \"{{user_password}}\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/token/", "host": ["{{baseUrl}}"], "path": ["api","token",""] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('token obtain status 200', function() { pm.response.to.have.status(200); });",
              "var json = pm.response.json ? pm.response.json() : {};",
              "// SimpleJWT returns { access: '...', refresh: '...' }",
              "if(json.access) { pm.environment.set('access_token', json.access); }",
              "if(json.refresh) { pm.environment.set('refresh_token', json.refresh); }",
              "pm.test('access token set', function() { pm.expect(pm.environment.get('access_token')||'').to.not.equal(''); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Refresh access token",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/token/refresh/", "host": ["{{baseUrl}}"], "path": ["api","token","refresh",""] }
      },
      "event": [ { "listen": "test", "script": { "exec": ["pm.test('refresh status 200', function(){ pm.response.to.have.status(200); }); var j = pm.response.json(); if(j && j.access) pm.environment.set('access_token', j.access);"], "type": "text/javascript" } } ]
    },
    {
      "name": "Verify token",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"token\": \"{{access_token}}\"\n}" }, "url": { "raw": "{{baseUrl}}/api/token/verify/", "host": ["{{baseUrl}}"], "path": ["api","token","verify",""] } },
      "response": []
    },
    {
      "name": "Get current user (dj-rest-auth)",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }], "url": { "raw": "{{baseUrl}}/api/auth/user/", "host": ["{{baseUrl}}"], "path": ["api","auth","user",""] } },
      "response": []
    },
    {
      "name": "My Profile - GET",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }], "url": { "raw": "{{baseUrl}}/api/auth/me/", "host": ["{{baseUrl}}"], "path": ["api","auth","me",""] } },
      "response": []
    },
    {
      "name": "My Profile - PATCH",
      "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{access_token}}" }], "body": { "mode": "raw", "raw": "{ \"first_name\": \"Lucas\", \"last_name\": \"Souza\" }" }, "url": { "raw": "{{baseUrl}}/api/auth/me/", "host": ["{{baseUrl}}"], "path": ["api","auth","me",""] } },
      "response": []
    },
    {
      "name": "Logout (dj-rest-auth)",
      "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }], "url": { "raw": "{{baseUrl}}/api/auth/logout/", "host": ["{{baseUrl}}"], "path": ["api","auth","logout",""] } },
      "response": []
    },
    {
      "name": "List Suggestions (public)",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/suggestions/", "host": ["{{baseUrl}}"], "path": ["api","suggestions",""] }
      },
      "event": [
        {
          "listen": "test",
          "script": { "exec": ["pm.test('list returns 200', function(){ pm.response.to.have.status(200); });"], "type": "text/javascript" }
        }
      ]
    },
    {
      "name": "Suggestions - List Filters (discovery)",
      "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/suggestions/filters/", "host": ["{{baseUrl}}"], "path": ["api","suggestions","filters",""] } },
      "response": []
    },
    {
      "name": "API Schema (discovery)",
      "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/schema/", "host": ["{{baseUrl}}"], "path": ["api","schema",""] } },
      "response": []
    },
    {
      "name": "Retrieve Suggestion",
      "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/suggestions/{{suggestion_id}}/", "host": ["{{baseUrl}}"], "path": ["api","suggestions","{{suggestion_id}}",""] } },
      "response": []
    },
    {
      "name": "Update Suggestion (auth)",
      "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{access_token}}" }], "body": { "mode": "raw", "raw": "{ \"title\": \"Updated title\" }" }, "url": { "raw": "{{baseUrl}}/api/suggestions/{{suggestion_id}}/", "host": ["{{baseUrl}}"], "path": ["api","suggestions","{{suggestion_id}}",""] } },
      "response": []
    },
    {
      "name": "Delete Suggestion (auth)",
      "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }], "url": { "raw": "{{baseUrl}}/api/suggestions/{{suggestion_id}}/", "host": ["{{baseUrl}}"], "path": ["api","suggestions","{{suggestion_id}}",""] } },
      "response": []
    },
    {
      "name": "Create Suggestion (auth)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{access_token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"Sugestão de teste\",\n  \"description\": \"Detalhes da sugestão gerada pelo Postman collection.\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/suggestions/", "host": ["{{baseUrl}}"], "path": ["api","suggestions",""] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('create suggestion status 201', function(){ pm.response.to.have.status(201); });",
              "var json = pm.response.json();",
              "pm.environment.set('suggestion_id', json.id + '');",
              "pm.test('saved suggestion_id', function(){ pm.expect(pm.environment.get('suggestion_id')).to.not.equal(''); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Create Comment (auth)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{access_token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"suggestion\": {{suggestion_id}},\n  \"content\": \"Comentário de teste via collection\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/comments/", "host": ["{{baseUrl}}"], "path": ["api","comments",""] }
      },
      "event": [ { "listen": "test", "script": { "exec": ["pm.test('comment create 201 or 200', function(){ pm.expect(pm.response.code).to.be.oneOf([200,201]); }); var j = pm.response.json(); if(j && j.id) pm.environment.set('comment_id', j.id+'');"], "type": "text/javascript" } } ]
    },
    {
      "name": "Retrieve Comment",
      "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/comments/{{comment_id}}/", "host": ["{{baseUrl}}"], "path": ["api","comments","{{comment_id}}",""] } },
      "response": []
    },
    {
      "name": "Delete Comment (auth)",
      "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }], "url": { "raw": "{{baseUrl}}/api/comments/{{comment_id}}/", "host": ["{{baseUrl}}"], "path": ["api","comments","{{comment_id}}",""] } },
      "response": []
    },
    {
      "name": "Vote Suggestion (auth)",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{access_token}}" } ],
        "body": { "mode": "raw", "raw": "{\n  \"suggestion\": {{suggestion_id}}\n}" },
        "url": { "raw": "{{baseUrl}}/api/votes/", "host": ["{{baseUrl}}"], "path": ["api","votes",""] }
      },
      "event": [ { "listen": "test", "script": { "exec": ["pm.test('vote created or existing returns 201 or 200', function(){ pm.expect(pm.response.code).to.be.oneOf([200,201]); }); var j=pm.response.json(); if(j && j.id) pm.environment.set('vote_id', j.id+'');"], "type": "text/javascript" } } ]
    },
    {
      "name": "Retrieve Vote",
      "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/votes/{{vote_id}}/", "host": ["{{baseUrl}}"], "path": ["api","votes","{{vote_id}}",""] } },
      "response": []
    },
    {
      "name": "Delete Vote (auth)",
      "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }], "url": { "raw": "{{baseUrl}}/api/votes/{{vote_id}}/", "host": ["{{baseUrl}}"], "path": ["api","votes","{{vote_id}}",""] } },
      "response": []
    },
    {
      "name": "Approve Suggestion (approver token)",
      "request": {
        "method": "POST",
        "header": [ { "key": "Authorization", "value": "Bearer {{approver_token}}" } ],
        "url": { "raw": "{{baseUrl}}/api/suggestions/{{suggestion_id}}/approve/", "host": ["{{baseUrl}}"], "path": ["api","suggestions","{{suggestion_id}}","approve",""] }
      },
      "event": [ { "listen": "test", "script": { "exec": ["pm.test('approve returns 200 or 204', function(){ pm.expect(pm.response.code).to.be.oneOf([200,204]); });"], "type": "text/javascript" } } ]
    },
    {
      "name": "Reject Suggestion (approver token)",
      "request": {
        "method": "POST",
        "header": [ { "key": "Authorization", "value": "Bearer {{approver_token}}" } ],
        "url": { "raw": "{{baseUrl}}/api/suggestions/{{suggestion_id}}/reject/", "host": ["{{baseUrl}}"], "path": ["api","suggestions","{{suggestion_id}}","reject",""] }
      },
      "event": [ { "listen": "test", "script": { "exec": ["pm.test('reject returns 200 or 204', function(){ pm.expect(pm.response.code).to.be.oneOf([200,204]); });"], "type": "text/javascript" } } ]
    },
    {
      "name": "List Audit Logs (auth)",
      "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "Bearer {{access_token}}" } ], "url": { "raw": "{{baseUrl}}/api/audit/", "host": ["{{baseUrl}}"], "path": ["api","audit",""] } },
      "event": [ { "listen": "test", "script": { "exec": ["pm.test('audit list 200', function(){ pm.response.to.have.status(200); });"], "type": "text/javascript" } } ]
    },
    {
      "name": "Retrieve Audit Log (auth)",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }], "url": { "raw": "{{baseUrl}}/api/audit/{{suggestion_id}}/", "host": ["{{baseUrl}}"], "path": ["api","audit","{{suggestion_id}}",""] } },
      "response": []
    },
    {
      "name": "Gestão - List Groups",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }], "url": { "raw": "{{baseUrl}}/api/gestao/groups/", "host": ["{{baseUrl}}"], "path": ["api","gestao","groups",""] } },
      "response": []
    },
    {
      "name": "Gestão - Create Group",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{access_token}}" }], "body": { "mode": "raw", "raw": "{ \"name\": \"approvers\", \"permissions\": [] }" }, "url": { "raw": "{{baseUrl}}/api/gestao/groups/", "host": ["{{baseUrl}}"], "path": ["api","gestao","groups",""] } },
      "event": [ { "listen": "test", "script": { "exec": ["pm.test('group create 201', function(){ pm.response.to.have.status(201); }); var j = pm.response.json(); if(j && j.id) pm.environment.set('group_id', j.id+'');"], "type": "text/javascript" } } ],
      "response": []
    },
    {
      "name": "Gestão - Retrieve Group",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }], "url": { "raw": "{{baseUrl}}/api/gestao/groups/{{group_id}}/", "host": ["{{baseUrl}}"], "path": ["api","gestao","groups","{{group_id}}",""] } },
      "response": []
    },
    {
      "name": "Gestão - Update Group (auth)",
      "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{access_token}}" }], "body": { "mode": "raw", "raw": "{ \"name\": \"newname\" }" }, "url": { "raw": "{{baseUrl}}/api/gestao/groups/{{group_id}}/", "host": ["{{baseUrl}}"], "path": ["api","gestao","groups","{{group_id}}",""] } },
      "response": []
    },
    {
      "name": "Gestão - Delete Group (auth)",
      "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }], "url": { "raw": "{{baseUrl}}/api/gestao/groups/{{group_id}}/", "host": ["{{baseUrl}}"], "path": ["api","gestao","groups","{{group_id}}",""] } },
      "response": []
    },
    {
      "name": "Gestão - List Permissions",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }], "url": { "raw": "{{baseUrl}}/api/gestao/permissions/", "host": ["{{baseUrl}}"], "path": ["api","gestao","permissions",""] } },
      "response": []
    },
    {
      "name": "Gestão - Retrieve Permission",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }], "url": { "raw": "{{baseUrl}}/api/gestao/permissions/{{permission_id}}/", "host": ["{{baseUrl}}"], "path": ["api","gestao","permissions","{{permission_id}}",""] } },
      "response": []
    },
    {
      "name": "Onr Models - List",
      "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/onr-models/", "host": ["{{baseUrl}}"], "path": ["api","onr-models",""] } },
      "event": [ { "listen": "test", "script": { "exec": ["pm.test('onr list 200', function(){ pm.response.to.have.status(200); });"], "type": "text/javascript" } } ]
    }
    ,
    {
      "name": "Onr - Filters (discovery)",
      "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/onr-models/filters/", "host": ["{{baseUrl}}"], "path": ["api","onr-models","filters",""] } },
      "response": []
    }
  ]
}
